# Copy to .env.production (never commit it) and fill in real values.
SECRET_KEY=generate-with-python-c-"import secrets;print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=circliq.example.edu
CSRF_TRUSTED_ORIGINS=https://circliq.example.edu
ADMIN_URL=manage-7f3k2/            # change this: the Django admin lives here instead of /admin/
TRUST_PROXY_HEADERS=True           # True only behind Caddy/Nginx/a load balancer you control
LOG_LEVEL=INFO

# Email (verification + password reset). Use your institution's SMTP or a provider.
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Circliq <no-reply@circliq.example.edu>

# Used by docker-compose.yml (put these in a file named .env next to docker-compose.yml)
# POSTGRES_PASSWORD=choose-a-long-random-password
# DOMAIN=circliq.example.edu
