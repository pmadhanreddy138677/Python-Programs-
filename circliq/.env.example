# Development settings. Copy this file to .env. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL commented to use SQLite. For PostgreSQL:
# DATABASE_URL=postgres://circliq_user:yourpassword@localhost:5432/circliq
# Optional: shared channel layer / cache / rate limits (needed with more than one server process)
# REDIS_URL=redis://localhost:6379/0
# For production use .env.production.example and see docs/DEPLOYMENT.md
